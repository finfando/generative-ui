{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "agent",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "agent",
        "langgraph",
        "dev",
        "--no-browser"
      ],
      "port": 2024
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "mcp-apps",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mcp-apps",
        "run",
        "dev"
      ],
      "port": 5180
    }
  ]
}